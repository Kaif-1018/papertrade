.PHONY: help up down down-v restart build logs test test-verbose migrate makemigrations seed-admin lint

help:
	@echo "Available commands:"
	@echo "  make up             - Build and start all services in detached mode"
	@echo "  make down           - Stop all services"
	@echo "  make down-v         - Stop services and remove volumes (clean database/redis)"
	@echo "  make restart        - Restart all containers"
	@echo "  make logs           - Stream container logs for api"
	@echo "  make test           - Run full pytest test suite inside Docker"
	@echo "  make test-verbose   - Run pytest with verbose output"
	@echo "  make migrate        - Apply Alembic database migrations"
	@echo "  make makemigrations - Generate a new Alembic migration (usage: make makemigrations m=\"msg\")"
	@echo "  make seed-admin     - Promote a user to admin (usage: make seed-admin email=\"user@example.com\")"
	@echo "  make lint           - Run ruff linter inside Docker"

up:
	docker compose up -d --build

down:
	docker compose down

down-v:
	docker compose down -v

restart:
	docker compose restart

build:
	docker compose build

logs:
	docker compose logs -f api

test:
	docker compose exec api pytest -q

test-verbose:
	docker compose exec api pytest -v

migrate:
	docker compose exec api alembic upgrade head

makemigrations:
	docker compose exec api alembic revision --autogenerate -m "$(or $(m),autogenerated migration)"

seed-admin:
	docker compose exec api python -m app.cli.seed_admin $(email)

lint:
	docker compose exec api python -m compileall app tests
